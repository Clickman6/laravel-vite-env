{
    "name": "clickman6/laravel-vite-env",
    "description": "Serve whitelisted VITE_* environment values as /vite-env.js, sourced from Laravel's cached config — no files, no .env at runtime.",
    "keywords": ["laravel", "vite", "config", "env", "frontend"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/clickman6/laravel-vite-env",
    "support": {
        "issues": "https://github.com/clickman6/laravel-vite-env/issues",
        "source": "https://github.com/clickman6/laravel-vite-env"
    },
    "authors": [
        {
            "name": "clickman6"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Clickman6\\LaravelViteEnv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clickman6\\LaravelViteEnv\\ViteEnvServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
